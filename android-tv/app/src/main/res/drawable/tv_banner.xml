<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 320x180dp Leanback Banner dark gradient backdrop -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:centerColor="#FF0A162D"
                android:endColor="#FF070B14"
                android:startColor="#FF122852"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#FF1E3A5F" />
        </shape>
    </item>

    <!-- Subtle bottom sky-blue broadcast accent line -->
    <item
        android:bottom="16dp"
        android:gravity="bottom|center_horizontal"
        android:height="3dp"
        android:width="140dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#FF38BDF8"
                android:endColor="#0038BDF8"
                android:startColor="#0038BDF8"
                android:type="linear" />
        </shape>
    </item>

    <!-- Centered TV launcher emblem -->
    <item
        android:drawable="@drawable/ic_tv_launcher"
        android:gravity="center"
        android:height="104dp"
        android:width="104dp" />

</layer-list>
