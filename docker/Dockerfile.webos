FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    fonts-noto-core \
    fonts-dejavu-core \
    binutils \
    tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .

# Rebuild unified OTA manifest & package clean LG webOS IPK
RUN node scripts/build-ota-manifest.js && \
    mkdir -p dist && \
    cp index.html manager.html remote.html ota-manifest.json epg-il.xml appinfo.json app-config.json icon.png largeIcon.png dist/ && \
    cp -r css js dist/ && \
    npx ares-package -n dist && \
    IPK_FILE="$(ls -1 com.iptv.livetv_*_all.ipk | head -n 1)" && \
    test -n "$IPK_FILE" && \
    mkdir -p /tmp/ipk-check /tmp/ipk-www && \
    ar p "$IPK_FILE" data.tar.gz | tar -xz -C /tmp/ipk-check && \
    cp -r /tmp/ipk-check/usr/palm/applications/com.iptv.livetv/* /tmp/ipk-www/ && \
    test -f /tmp/ipk-www/index.html && \
    test -f /tmp/ipk-www/css/style.css && \
    test -f /tmp/ipk-www/css/theme-glass.css && \
    test -f /tmp/ipk-www/js/app.js && \
    test -f /tmp/ipk-www/ota-manifest.json

CMD ["node", "scripts/test-e2e.js", "--platform=webos", "--web-root=/tmp/ipk-www", "--repo-root=/app"]
