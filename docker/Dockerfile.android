FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV GRADLE_HOME=/opt/gradle
ENV PATH="${GRADLE_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    openjdk-17-jdk-headless \
    chromium \
    fonts-noto-core \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* && \
    ln -sfn "$(dirname "$(dirname "$(readlink -f "$(which javac)")")")" /opt/java-17

ENV JAVA_HOME=/opt/java-17

RUN curl -fsSL https://services.gradle.org/distributions/gradle-8.7-bin.zip -o /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt && \
    mv /opt/gradle-8.7 /opt/gradle && \
    rm -f /tmp/gradle.zip && \
    mkdir -p /opt/android-sdk/cmdline-tools && \
    curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/cmdline.zip && \
    unzip -q /tmp/cmdline.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm -f /tmp/cmdline.zip && \
    yes | sdkmanager --licenses >/dev/null && \
    sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

COPY . .

# Rebuild OTA manifest, compile both Android APKs, verify signatures, and extract packaged assets/www
RUN node scripts/build-ota-manifest.js && \
    cd /app/android-tv && gradle assembleRelease --no-daemon && \
    cd /app/android-installer && gradle assembleDebug --no-daemon && \
    cd /app && \
    /opt/android-sdk/build-tools/34.0.0/apksigner verify --print-certs android-tv/app/build/outputs/apk/release/app-release.apk && \
    /opt/android-sdk/build-tools/34.0.0/apksigner verify --print-certs android-installer/app/build/outputs/apk/debug/app-debug.apk && \
    mkdir -p /tmp/apk-extract /tmp/apk-www && \
    unzip -q android-tv/app/build/outputs/apk/release/app-release.apk "assets/www/*" -d /tmp/apk-extract && \
    cp -r /tmp/apk-extract/assets/www/* /tmp/apk-www/ && \
    test -f /tmp/apk-www/index.html && \
    test -f /tmp/apk-www/css/style.css && \
    test -f /tmp/apk-www/css/theme-glass.css && \
    test -f /tmp/apk-www/js/app.js && \
    test -f /tmp/apk-www/ota-manifest.json

CMD ["node", "scripts/test-e2e.js", "--platform=androidtv", "--web-root=/tmp/apk-www", "--repo-root=/app"]
